# AEGIS configuration. Copy to backend/.env (or export the variables) and adjust.
# Every variable is optional; the values below are the defaults.
# Never commit a real .env file.

# development | test | production
AEGIS_ENVIRONMENT=development

# SQLAlchemy database URL. Default: SQLite file at backend/data/aegis.db
# AEGIS_DATABASE_URL=sqlite:///./data/aegis.db

# Comma-separated list of browser origins allowed to call the API directly.
# Wildcards ("*") are rejected on purpose.
AEGIS_CORS_ORIGINS=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR
AEGIS_LOG_LEVEL=INFO

# --- Frontend (read by Vite at build/dev time) ---
# Leave empty in development: the Vite dev server proxies /api to the backend.
# VITE_API_BASE_URL=
# Where the Vite dev proxy forwards /api requests.
# AEGIS_BACKEND_URL=http://127.0.0.1:8000
